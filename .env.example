# Argus Stack configuration. Copy to the root .env; Compose reads it automatically.
# Put secrets containing $ in single quotes, e.g. OPENSKY_CLIENT_SECRET='abc$def'.

# ADS-B service: existing host recording directory, relative to the stack root
# or an absolute path. Existing LOG_DIR and INTERVAL_SECONDS settings still apply.
# The default is included; create custom directories before starting Compose.
# The container always writes to /data, mounted here.
LOG_DIR=./data
INTERVAL_SECONDS=30
LOG_VERBOSE=false

# Web dashboard. Use 0.0.0.0 for access from other machines on a trusted LAN.
# The dashboard has no login; the default exposes it only on this machine.
DASHBOARD_BIND_ADDRESS=127.0.0.1
DASHBOARD_PORT=3000

# File ownership on Linux. For your user, set these to `id -u` and `id -g`.
# The entrypoint prepares the directory, then runs Python with these IDs.
LOGGER_UID=1000
LOGGER_GID=1000

# Optional OpenSky OAuth API client credentials (both or neither).
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Shared MQTT connection for the dashboard and ADS-B service.
# The Compose service name is the broker hostname inside Docker.
MQTT_HOST=mqtt
MQTT_PORT=1883
MQTT_TOPIC_PREFIX=adsb-logger
MQTT_CLIENT_ID=

# Host access to the bundled broker; these do not change its internal port.
MQTT_BIND_ADDRESS=127.0.0.1
MQTT_PUBLISHED_PORT=1883

# Optional credentials/TLS for an external broker. The bundled broker is anonymous.
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS=false
# Custom CA path INSIDE the container; requires a read-only volume in an override.
MQTT_CA=
